# Fresh & More M-POS Production & Security Configuration

# GEMINI_API_KEY: Optional/required if Gemini features are utilized
GEMINI_API_KEY=""

# Application Host URL
APP_URL="http://localhost:3000"

# Server Port
PORT=3000

# Environment: 'production' | 'development' | 'test'
NODE_ENV="production"

# Demo seeding: Keep FALSE in production. Set to true ONLY in local dev if you want demo users created.
ENABLE_DEV_SEED="false"

# Path to the persistent JSON database file (defaults to data/pos_production_db.json)
PERSISTENT_DB_PATH="data/pos_production_db.json"

# Production Super Admin Initial Bootstrap Credentials (used on initial fresh deployment if no super admin exists)
INITIAL_SUPER_ADMIN_NAME="System Administrator"
INITIAL_SUPER_ADMIN_EMAIL="admin@freshandmore.rw"
INITIAL_SUPER_ADMIN_PHONE="+250 788 111 222"
INITIAL_SUPER_ADMIN_PASSWORD="ReplaceWithAStrongSecurePassphrase123!"

# CORS Allowed Origins: Comma-separated list of allowed web origins, e.g. "https://emmanuelmuke58-stack.github.io,https://mypos.rw"
CORS_ORIGIN="https://emmanuelmuke58-stack.github.io"

# Client-Side API Base URL (Vite environment variable)
# Leave empty for same-origin (full-stack Express + Vite), or specify the deployed backend URL (e.g., https://api.freshandmore.rw) when hosting static frontend on GitHub Pages.
VITE_API_BASE_URL=""

# Base path for router/assets (defaults to '/' locally, or '/M-POS-RWANDA/' on GitHub Pages)
VITE_BASE_PATH="/"
